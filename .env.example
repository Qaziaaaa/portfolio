# Server-side agent keys (Python/LangChain — never bundled into the frontend).
# Vite only exposes VITE_-prefixed vars, so these stay server-only.

# Groq Chat Completions API key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Jina AI Embeddings API key (free at jina.ai)
JINA_API_KEY=your_jina_api_key_here

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-agent

# Optional agent tuning (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low   # low (fast/free-tier friendly) | medium | high (needs Groq paid tier)
